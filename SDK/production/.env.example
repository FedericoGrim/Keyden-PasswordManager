# Copy to .env in this same folder and fill in real values before
# running: docker compose --env-file .env up -d --build

# ========== App database (Postgres) ==========
DB_USER=...
DB_PASSWORD=...
DB_NAME=password_manager

# ========== Keycloak database (same Postgres instance, separate DB/role) ==========
KC_DB_NAME=keycloak
KC_DB_USER=...
KC_DB_PASSWORD=...

# ========== Keycloak ==========
KC_ADMIN_USER=...
KC_ADMIN_PASSWORD=...
# Public hostname/domain Keycloak will be reached at (browser + backend token validation)
KC_HOSTNAME=auth.example.com
KC_REALM=PasswordManager
KC_CLIENT_ID=PasswordManager-frontend
KC_AUDIENCE=account

# ========== Backend (FastAPI) ==========
FRONTEND_URL=https://app.example.com
DEBUG=false

# ========== Frontend (Next.js, baked in at build time) ==========
# Also used by the backend as OIDC issuer base: <url>/realms/<KC_REALM>
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_KEYCLOAK_REFRESH_INTERVAL=60000
