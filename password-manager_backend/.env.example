# ========== PostgreSQL Configuration ==========
DB_USER=...
DB_PASSWORD=...
DB_HOST=...
DB_PORT=...
DB_NAME=...

# ========== CORS Configuration ==========
# Comma-separated list of allowed origins, e.g.:
# FRONTEND_URL=http://localhost:3000,https://app.keyden.example
FRONTEND_URL=http://localhost:3000

# ========== API Configuration ==========
DEBUG=...

# ========== OpenID Connect (any provider: Keycloak, Auth0, Entra, ...) ==========
# Must match the token's "iss" claim exactly (Keycloak: http://<host>:<port>/realms/<realm>)
OIDC_ISSUER=...
OIDC_AUDIENCE=...
# Optional: only when the backend reaches the IdP on a different host than OIDC_ISSUER
# OIDC_DISCOVERY_URL=http://keycloak:8080/realms/<realm>/.well-known/openid-configuration
